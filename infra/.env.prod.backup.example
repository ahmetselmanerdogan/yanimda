# T-083 günlük yedek kabının ortamı (compose `env_file` → yalnız backup; geri yükleme tatbikatının indirme adımı
# da bu kabı kullanır). Uygulama sırları burada YOK. Dökümü okuma yetkili ayrı kullanıcı (infra/README.md "Yedek").
# Değerlerde `$` kullanmayın (compose env_file değerlerini de çözer); ön kontrol reddeder. İzin 0600, git dışı.
BACKUP_DATABASE_URL=postgres://yanimda_backup:CHANGE_ME@10.20.1.10:5432/yanimda?sslmode=verify-full&sslrootcert=/etc/yanimda/tls/ca.pem
BACKUP_S3_BUCKET=yanimda-staging-backups
BACKUP_S3_ENDPOINT=https://obs.tr-west-1.myhuaweicloud.com
BACKUP_S3_PREFIX=pg/staging
BACKUP_RETENTION_DAYS=35
# Günlük döküm saati (UTC)
BACKUP_AT=03:15
# Yedek kovasına yazma yetkili OBS/S3 anahtarı (aws CLI adlarıyla)
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_DEFAULT_REGION=tr-west-1
PUSHGATEWAY_URL=http://pushgateway:9091
