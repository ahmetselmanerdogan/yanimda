# T-083 API / outbox işçisi / migration kabının ortamı (compose `env_file` → api, worker, migrate; Helm'de
# api.existingSecret + api.env). YALNIZ API'nin okuduğu değişkenler: Keycloak yönetici/DB, yedek, Grafana ve dışa
# aktarıcı sırları BURAYA YAZILMAZ (apps/api/test/contract-parity.spec.ts denetler). Ayrıntı: kök .env.example.
# Kopyala: scripts/prod-preflight.sh --init  ·  Doğrula: scripts/prod-preflight.sh
# Değerlerde `$` kullanmayın (compose env_file değerlerini de çözer); ön kontrol reddeder.

NODE_ENV=production
DATABASE_URL=postgres://yanimda:CHANGE_ME@10.20.1.10:5432/yanimda?sslmode=verify-full&sslrootcert=/etc/yanimda/tls/ca.pem
DATABASE_POOL_MAX=10
# Migration ayrı tek seferlik "migrate" servisinde (compose) / Helm hook Job'unda; api/worker kapları açılışta
# migration çalıştırmaz (compose bunu ayrıca false'a zorlar). Geri dönüş: infra/README.md "Migration ve geri dönüş".
DB_MIGRATE_ON_START=false
# DCS ACL hesabı (Terraform redis_app_user) + TLS
REDIS_URL=rediss://yanimda-app:CHANGE_ME@10.20.1.20:6379
OUTBOX_POLL_MS=1000
# 0038: süreç başına paralel outbox bölümü (≤ DATABASE_POOL_MAX − HTTP payı)
OUTBOX_CONCURRENCY=4
# Rutin tur sırasında acil iş yoklama aralığı (ms); aşırı yükte SOS bir toplu turu beklemez
OUTBOX_YIELD_CHECK_MS=500
TIMERS_PREFIX=yanimda
SIMULATOR_ENABLED=false
# ADMIN_TOKEN üretimde tanımlanmaz: doluysa API açılmaz (T-081 G-4); yönetici uçları yalnız OIDC ADMIN (MFA).
DEVICE_TOKEN_SECRET=CHANGE_ME_openssl_rand_hex_32
FIELD_ENC_KEYS=k1:CHANGE_ME_base64_32_bytes
# T-060 web kaydı doğrulama token'ı imzası (≥ 32 karakter, üretimde zorunlu)
SIGNUP_TOKEN_SECRET=CHANGE_ME_at_least_32_chars
# T-081 anahtar döndürme: "<kid>:<sır>[,<eski kid>:<sır>]" (docs/security/sirlar.md §4.2); BLE köprü adres özeti HMAC anahtarı
DEVICE_TOKEN_SECRETS=
BLE_ADDRESS_PEPPER=CHANGE_ME_openssl_rand_hex_32
KEYCLOAK_URL=https://auth.staging.yanimda.example
OIDC_OPERATIONS_ISSUER=https://auth.staging.yanimda.example/realms/operations
OIDC_CONSUMERS_ISSUER=https://auth.staging.yanimda.example/realms/consumers
OIDC_AUDIENCE=yanimda-api
OIDC_REQUIRE_MFA=true
METRICS_HOST=0.0.0.0
COUNTRY_CODE=TR
OPERATOR_LOCK_SEC=300
S3_ENDPOINT=https://obs.tr-west-1.myhuaweicloud.com
S3_BUCKET=yanimda-staging-recordings
S3_REGION=tr-west-1
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_ENSURE_BUCKET=false
RECORDING_RETENTION_DAYS=30
CPAAS_PROVIDER=twilio
CPAAS_WEBHOOK_BASE=https://api.staging.yanimda.example
CPAAS_AGENT_NUMBER=
# T-052 gelen SOS numarası (saatlerin aradığı) ve yedeği (E.164); T-054 eşlikçi telefonun tanıdığı operatör numaraları
CPAAS_INBOUND_NUMBER=
CPAAS_BACKUP_NUMBER=
OPERATOR_CALLER_IDS=
OPERATOR_DISPLAY_NAME=Yanımda
CPAAS_SOFTPHONE=on
TWILIO_ACCOUNT_SID=CHANGE_ME
TWILIO_AUTH_TOKEN=CHANGE_ME
TWILIO_FROM_NUMBER=+900000000000
TWILIO_BYOC_TRUNK_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
GOOGLE_GEOCODING_KEY=
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_TOPIC=app.yanimda.companion
# Personel web push (PWA amir uyarıları; apps/api webpush). Üret: npx web-push generate-vapid-keys. Boşsa web push kapalı.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:destek@yanimda.app
# T-060 web abonelik ve ödeme (apps/api billing). Keycloak consumers hesabı açan hizmet hesabı istemcisi. Aynı değer
# .env.prod.keycloak YANIMDA_SIGNUP_CLIENT_SECRET'ta (realm içe aktarımı); ön kontrol eşliği denetler.
KEYCLOAK_SIGNUP_CLIENT_ID=yanimda-signup
KEYCLOAK_SIGNUP_CLIENT_SECRET=CHANGE_ME_openssl_rand_hex_32
KEYCLOAK_CONSUMERS_REALM=consumers
KEYCLOAK_FAMILY_CLIENT_ID=family-web
# Aile web kökü (ödeme dönüş adresleri) ve sağlayıcının eriştiği genel API kökü (iyzico callback, Stripe webhook)
FAMILY_WEB_URL=https://aile.staging.yanimda.example
PUBLIC_API_URL=https://api.staging.yanimda.example
# Ödeme: live zorunlu (fake üretimde açılmaz). TR → iyzico, US → Stripe; anahtarı olmayan ülkede kayıt 503.
PAYMENT_PROVIDER=live
IYZICO_API_KEY=CHANGE_ME
IYZICO_SECRET_KEY=CHANGE_ME
IYZICO_MERCHANT_ID=CHANGE_ME
# Staging: https://sandbox-api.iyzipay.com · canlı: https://api.iyzipay.com
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
IYZICO_PLAN_STANDARD=
IYZICO_PLAN_STANDARD_YEARLY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_STANDARD_YEARLY=
# KVKK aydınlatma metni sürümü (aile web aynı sürümü gönderir)
KVKK_NOTICE_VERSION=taslak-2026-11
# T-092 değer kuralları bayrağı: yazılı mevzuat görüşü olmadan true yapılmaz
VITALS_ENABLED=false
