# T-083 izleme compose'unun sırları: İKİNCİ --env-file olarak verilir (değişken çözümü), hiçbir kaba env_file
# olarak verilmez; her değer yalnız onu adıyla anan kaba gider (Grafana parolası → grafana, DSN → postgres-exporter,
# Redis hesabı → redis-exporter). Alertmanager sırları ayrı dosyalarda: infra/monitoring/secrets/README.md.
#   docker compose --env-file infra/.env.prod --env-file infra/.env.prod.monitoring \
#     -f infra/monitoring/docker-compose.monitoring.yml up -d
# İzin 0600, git dışı.
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
# postgres_exporter: salt okunur izleme kullanıcısı (README "İzleme kullanıcısı")
PG_EXPORTER_DSN=postgresql://yanimda_monitor:CHANGE_ME@10.20.1.10:5432/yanimda?sslmode=verify-full&sslrootcert=/etc/yanimda/tls/ca.pem
REDIS_EXPORTER_ADDR=rediss://10.20.1.20:6379
# DCS salt okunur ACL hesabı (Terraform redis_monitor_user)
REDIS_EXPORTER_USER=yanimda-monitor
REDIS_EXPORTER_PASSWORD=CHANGE_ME
