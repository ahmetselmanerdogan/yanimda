#!/bin/bash
# T-083 VPS ilk açılış: Docker Engine + compose eklentisi, veri diski ${data_mount}, temel sertleştirme.
# Uygulama dosyaları ve .env.prod* buraya kopyalanmaz (sır yok); dağıtım infra/README.md'de.
set -euo pipefail

export DEBIAN_FRONTEND=noninteractive
apt-get update -y
apt-get install -y ca-certificates curl gnupg unattended-upgrades fail2ban chrony

# T-081 (ASVS 7.3.4): saat eşitleme (chrony, bulut iç NTP) ve UTC. Log/metrik zaman damgaları UTC; sapma
# node_exporter timex → Prometheus ClockNotSynchronised/ClockSkew uyarıları (infra/monitoring/alerts.yml).
timedatectl set-timezone UTC
mkdir -p /etc/chrony/sources.d
: > /etc/chrony/sources.d/yanimda.sources
for s in ${ntp_servers}; do echo "server $s iburst" >> /etc/chrony/sources.d/yanimda.sources; done
systemctl enable --now chrony
chronyc reload sources || systemctl restart chrony
chronyc makestep || true

install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
chmod a+r /etc/apt/keyrings/docker.asc
# shellcheck source=/dev/null
. /etc/os-release
echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $VERSION_CODENAME stable" > /etc/apt/sources.list.d/docker.list
apt-get update -y
apt-get install -y docker-ce docker-ce-cli containerd.io docker-compose-plugin

# Veri diski: ilk boş disk (sistem diski dışında) biçimlendirilip bağlanır. Disk eklenmesi birkaç saniye sürebilir.
for _ in $(seq 1 30); do
  DEV=$(lsblk -dpno NAME,TYPE,MOUNTPOINT | awk '$2=="disk" && $3=="" {print $1}' | grep -v "$(findmnt -no SOURCE / | sed 's/[0-9]*$//')" | head -n1 || true)
  [ -n "$DEV" ] && break
  sleep 5
done
mkdir -p "${data_mount}"
if [ -n "$DEV" ]; then
  blkid "$DEV" >/dev/null 2>&1 || mkfs.ext4 -L yanimda-data "$DEV"
  grep -q yanimda-data /etc/fstab || echo "LABEL=yanimda-data ${data_mount} ext4 defaults,nofail 0 2" >> /etc/fstab
  mount -a
fi

# Docker verisi veri diskinde; günlükler döndürülür (Loki/promtail okur).
mkdir -p "${data_mount}/docker" /etc/docker
cat > /etc/docker/daemon.json <<'JSON'
{ "data-root": "${data_mount}/docker", "log-driver": "json-file", "log-opts": { "max-size": "20m", "max-file": "5" }, "live-restore": true }
JSON
systemctl restart docker
systemctl enable --now docker unattended-upgrades fail2ban

# SSH: yalnız anahtar.
sed -i 's/^#\?PasswordAuthentication .*/PasswordAuthentication no/' /etc/ssh/sshd_config
systemctl reload ssh || systemctl reload sshd || true

# T-083 haftalık geri yükleme tatbikatı (infra/backup/restore-drill.sh): Pazar 04:00 UTC, günlük yedekten (03:15)
# sonra. Döküm yedek kabıyla indirilir (aws CLI + OBS kimlikleri .env.prod.backup'tan, env_file); geri yükleme ana
# makinede ağsız geçici TimescaleDB kabında. Sonuç restore_drill_* metrikleri (Pushgateway, yanimda ağı) →
# RestoreDrillFailed/Stale/TooSlow uyarıları. Depo yolu /etc/default/yanimda-restore-drill (YANIMDA_REPO).
# Elle: systemctl start yanimda-restore-drill.service && journalctl -u yanimda-restore-drill
[ -f /etc/default/yanimda-restore-drill ] || cat > /etc/default/yanimda-restore-drill <<'ENV'
YANIMDA_REPO=${data_mount}/yanimda
DRILL_MAX_SEC=3600
ENV
cat > /usr/local/sbin/yanimda-restore-drill <<'SH'
#!/bin/bash
set -euo pipefail
: "$${YANIMDA_REPO:?YANIMDA_REPO gerekli (/etc/default/yanimda-restore-drill)}"
cd "$YANIMDA_REPO"
mkdir -p ${data_mount}/drill
work=$(mktemp -d ${data_mount}/drill/run.XXXXXX)
cleanup() { [[ "$work" == ${data_mount}/drill/run.* ]] && rm -r -f -- "$work"; }
trap cleanup EXIT
mkdir "$work/fetch" "$work/tmp"
chown 70:70 "$work/fetch" # yedek kabı postgres (uid 70) kullanıcısıyla yazar
docker compose --env-file infra/.env.prod -f infra/docker-compose.prod.yml run --rm --no-deps \
  -v "$work/fetch:/drill" -e DRILL_FETCH_DIR=/drill backup /opt/backup/restore-drill.sh
manifest=""
[ ! -f "$work/fetch/db.manifest" ] || manifest="$work/fetch/db.manifest"
TMPDIR="$work/tmp" DRILL_DUMP_FILE="$work/fetch/db.dump" DRILL_MANIFEST_FILE="$manifest" \
  PUSHGATEWAY_URL=http://pushgateway:9091 PUSHGATEWAY_DOCKER_NETWORK=yanimda infra/backup/restore-drill.sh
SH
chmod 0750 /usr/local/sbin/yanimda-restore-drill
# OnFailure bildirimi: sarmalayıcı restore-drill.sh dışında düşse de (compose run, indirme, docker) başarısızlık
# metriği gider (RestoreDrillFailed) ve journald'a err düzeyinde kayıt düşer. restore-drill.sh kendi hatalarını
# EXIT tuzağıyla zaten iter; çift gönderim zararsız (aynı gauge).
cat > /usr/local/sbin/yanimda-restore-drill-failed <<'SH'
#!/bin/bash
set -uo pipefail
printf '# TYPE restore_drill_success gauge\nrestore_drill_success 0\n# TYPE restore_drill_last_run_timestamp_seconds gauge\nrestore_drill_last_run_timestamp_seconds %s\n' "$(date +%s)" |
  docker run --rm -i --network yanimda --entrypoint curl yanimda-backup:local \
    -fsS --max-time 10 --data-binary @- http://pushgateway:9091/metrics/job/restore_drill ||
  logger -p user.err -t yanimda-restore-drill "Pushgateway'e başarısızlık metriği yazılamadı (RestoreDrillStale yakalar)"
logger -p user.err -t yanimda-restore-drill "haftalık geri yükleme tatbikatı BAŞARISIZ: journalctl -u yanimda-restore-drill"
SH
chmod 0750 /usr/local/sbin/yanimda-restore-drill-failed
cat > /etc/systemd/system/yanimda-restore-drill-failed.service <<'UNIT'
[Unit]
Description=Yanımda geri yükleme tatbikatı başarısızlık bildirimi (OnFailure)
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/yanimda-restore-drill-failed
UNIT
cat > /etc/systemd/system/yanimda-restore-drill.service <<'UNIT'
[Unit]
Description=Yanımda haftalık geri yükleme tatbikatı (T-083)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
OnFailure=yanimda-restore-drill-failed.service

[Service]
Type=oneshot
EnvironmentFile=/etc/default/yanimda-restore-drill
ExecStart=/usr/local/sbin/yanimda-restore-drill
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=2h
UNIT
cat > /etc/systemd/system/yanimda-restore-drill.timer <<'UNIT'
[Unit]
Description=Yanımda haftalık geri yükleme tatbikatı (Pazar 04:00 UTC)

[Timer]
OnCalendar=Sun *-*-* 04:00:00 UTC
Persistent=true
RandomizedDelaySec=15m

[Install]
WantedBy=timers.target
UNIT
systemctl daemon-reload
systemctl enable --now yanimda-restore-drill.timer
