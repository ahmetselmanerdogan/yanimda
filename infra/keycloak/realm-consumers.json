{
  "realm": "consumers",
  "displayName": "Yanımda",
  "enabled": true,
  "sslRequired": "${YANIMDA_KC_SSL_REQUIRED:external}",
  "loginTheme": "yanimda",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "bruteForceProtected": true,
  "failureFactor": 10,
  "permanentLockout": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1209600,
  "ssoSessionMaxLifespan": 2592000,
  "offlineSessionIdleTimeout": 1209600,
  "offlineSessionMaxLifespanEnabled": true,
  "offlineSessionMaxLifespan": 2592000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "passwordPolicy": "length(12) and maxLength(128) and notUsername and notEmail and passwordHistory(3) and passwordBlacklist(yanimda-blacklist.txt)",
  "internationalizationEnabled": true,
  "supportedLocales": ["tr"],
  "defaultLocale": "tr",
  "roles": {
    "realm": [
      {
        "name": "ELDER",
        "description": "Korunan kişi"
      },
      {
        "name": "FAMILY",
        "description": "Aile yakını / abone"
      }
    ]
  },
  "defaultRoles": ["FAMILY"],
  "clients": [
    {
      "clientId": "family-app",
      "name": "Aile uygulaması",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "app.yanimda.family:/oauth2redirect",
        "${YANIMDA_FAMILY_APP_EXTRA_REDIRECT:http://localhost:5174/*}"
      ],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "fullScopeAllowed": true,
      "defaultClientScopes": ["basic", "profile", "roles", "web-origins", "acr", "email"],
      "optionalClientScopes": ["offline_access"],
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "yanimda-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "family-web",
      "name": "Aile web (abonelik)",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["${YANIMDA_FAMILY_WEB_URL:http://localhost:5175}/*"],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${YANIMDA_FAMILY_WEB_URL:http://localhost:5175}/*",
        "client.session.idle.timeout": "1800",
        "client.session.max.lifespan": "43200"
      },
      "fullScopeAllowed": true,
      "defaultClientScopes": ["basic", "profile", "roles", "web-origins", "acr", "email"],
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "yanimda-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "yanimda-signup",
      "name": "Web kayıt hizmet hesabı (T-060)",
      "description": "API'nin consumers hesabı açtığı istemci. Sır Keycloak'ta üretilir: KEYCLOAK_SIGNUP_CLIENT_SECRET (dev-users.mjs yazdırır). fullScopeAllowed=true: realm-management rolleri token'a girsin (yalnız manage-users/view-users atanır).",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": true
    }
  ],
  "users": [
    {
      "username": "service-account-yanimda-signup",
      "enabled": true,
      "serviceAccountClientId": "yanimda-signup",
      "clientRoles": {
        "realm-management": ["manage-users", "view-users"]
      }
    }
  ],
  "smtpServer": {
    "host": "${YANIMDA_KC_SMTP_HOST:mailhog}",
    "port": "${YANIMDA_KC_SMTP_PORT:1025}",
    "from": "${YANIMDA_KC_SMTP_FROM:noreply@yanimda.local}",
    "fromDisplayName": "Yanımda",
    "starttls": "${YANIMDA_KC_SMTP_STARTTLS:false}",
    "ssl": "${YANIMDA_KC_SMTP_SSL:false}",
    "auth": "${YANIMDA_KC_SMTP_AUTH:false}",
    "user": "${YANIMDA_KC_SMTP_USER:}",
    "password": "${YANIMDA_KC_SMTP_PASSWORD:}"
  },
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\": [{\"name\": \"username\", \"displayName\": \"${username}\", \"validations\": {\"length\": {\"min\": 3, \"max\": 255}, \"username-prohibited-characters\": {}, \"up-username-not-idn-homograph\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"email\", \"displayName\": \"${email}\", \"validations\": {\"email\": {}, \"length\": {\"max\": 255}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"firstName\", \"displayName\": \"${firstName}\", \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"lastName\", \"displayName\": \"${lastName}\", \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"phone_number\", \"displayName\": \"Telefon\", \"validations\": {\"pattern\": {\"pattern\": \"^\\\\+[1-9]\\\\d{6,14}$\", \"error-message\": \"E.164\"}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}, \"multivalued\": false}, {\"name\": \"phone_number_verified\", \"displayName\": \"Telefon doğrulandı\", \"permissions\": {\"view\": [\"admin\"], \"edit\": [\"admin\"]}, \"multivalued\": false}], \"groups\": [{\"name\": \"user-metadata\", \"displayHeader\": \"User metadata\", \"displayDescription\": \"Attributes, which refer to user metadata\"}]}"
          ]
        }
      }
    ]
  },
  "eventsEnabled": true,
  "eventsExpiration": 7776000,
  "eventsListeners": ["email"],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false
}
