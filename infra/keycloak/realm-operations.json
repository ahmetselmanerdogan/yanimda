{
  "realm": "operations",
  "displayName": "Yanımda Operasyon",
  "enabled": true,
  "sslRequired": "${YANIMDA_KC_SSL_REQUIRED:external}",
  "loginTheme": "yanimda",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "loginWithEmailAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "waitIncrementSeconds": 60,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 3600,
  "ssoSessionMaxLifespan": 43200,
  "passwordPolicy": "length(12) and notUsername and passwordHistory(5) and passwordBlacklist(yanimda-blacklist.txt)",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "internationalizationEnabled": true,
  "supportedLocales": ["tr"],
  "defaultLocale": "tr",
  "roles": {
    "realm": [
      {
        "name": "OPERATOR",
        "description": "Kuyruktaki olayları üstlenir ve yürütür"
      },
      {
        "name": "SUPERVISOR",
        "description": "Amir: üstlenmeyi geri alır, panoyu görür"
      },
      {
        "name": "ADMIN",
        "description": "Kural paketi, cihaz ve davet yönetimi"
      }
    ]
  },
  "requiredActions": [
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": true,
      "priority": 10,
      "config": {}
    },
    {
      "alias": "UPDATE_PASSWORD",
      "name": "Update Password",
      "providerId": "UPDATE_PASSWORD",
      "enabled": true,
      "defaultAction": false,
      "priority": 30,
      "config": {}
    }
  ],
  "browserFlow": "browser-otp",
  "authenticationFlows": [
    {
      "alias": "browser-otp",
      "description": "Parola + OTP zorunlu (E-01). OTP kurulmamışsa ilk girişte kurulum istenir.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "flowAlias": "browser-otp forms",
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "browser-otp forms",
      "description": "Kullanıcı adı/parola, ardından OTP",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorConfig": "amr-pwd"
        },
        {
          "authenticator": "auth-otp-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": true,
          "authenticatorConfig": "amr-otp"
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "console",
      "name": "Operatör konsolu",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "rootUrl": "${YANIMDA_CONSOLE_URL:http://localhost:5173}",
      "baseUrl": "/",
      "redirectUris": [
        "${YANIMDA_CONSOLE_URL:http://localhost:5173}/*",
        "${YANIMDA_CONSOLE_EXTRA_REDIRECT:http://127.0.0.1:5173/*}"
      ],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${YANIMDA_CONSOLE_URL:http://localhost:5173}/*##${YANIMDA_CONSOLE_EXTRA_REDIRECT:http://127.0.0.1:5173/*}",
        "client.session.idle.timeout": "3600",
        "client.session.max.lifespan": "43200"
      },
      "fullScopeAllowed": true,
      "defaultClientScopes": ["basic", "profile", "roles", "web-origins", "acr"],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "yanimda-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "amr",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-amr-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "amr-pwd",
      "config": {
        "default.reference.value": "pwd",
        "default.reference.maxAge": "43200"
      }
    },
    {
      "alias": "amr-otp",
      "config": {
        "default.reference.value": "otp",
        "default.reference.maxAge": "43200"
      }
    }
  ],
  "eventsEnabled": true,
  "eventsExpiration": 7776000,
  "eventsListeners": ["email"],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "smtpServer": {
    "host": "${YANIMDA_KC_SMTP_HOST:mailhog}",
    "port": "${YANIMDA_KC_SMTP_PORT:1025}",
    "from": "${YANIMDA_KC_SMTP_FROM:noreply@yanimda.local}",
    "fromDisplayName": "Yanımda Operasyon",
    "starttls": "${YANIMDA_KC_SMTP_STARTTLS:false}",
    "ssl": "${YANIMDA_KC_SMTP_SSL:false}",
    "auth": "${YANIMDA_KC_SMTP_AUTH:false}",
    "user": "${YANIMDA_KC_SMTP_USER:}",
    "password": "${YANIMDA_KC_SMTP_PASSWORD:}"
  }
}
