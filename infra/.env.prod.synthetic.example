# T-083 sentetik sonda kabının sırları (compose `env_file` → yalnız synthetic). Gizli olmayan sonda ayarları
# (.env.prod: SYNTHETIC_CLIENT_ID, SYNTHETIC_PERSON_IDS, aralık) compose'da. İzin 0600, git dışı.
# Keycloak consumers realm'indeki `yanimda-synthetic` istemcisinin sırrı: .env.prod.keycloak
# YANIMDA_SYNTHETIC_CLIENT_SECRET ile AYNI (ön kontrol eşler). Üret: openssl rand -hex 32
SYNTHETIC_CLIENT_SECRET=CHANGE_ME_openssl_rand_hex_32
# İsteğe bağlı Uptime Kuma push izleyicisi (adreste token var: sır gibi saklanır)
UPTIME_KUMA_PUSH_URL=
