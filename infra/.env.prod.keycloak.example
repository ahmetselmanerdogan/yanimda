# T-083 Keycloak kabının ortamı (compose `env_file` → yalnız keycloak). Ad alanı Keycloak'ın okuduğu adlardır
# (KC_*: sunucu; YANIMDA_*: realm içe aktarma yer tutucuları, infra/keycloak/realm-*.json). Alan adına bağlı değerler
# (KC_HOSTNAME, yönlendirme adresleri) compose'da DOMAIN'den türetilir. İzin 0600, git dışı.
# Değerlerde `$` kullanmayın (compose env_file değerlerini de çözer); ön kontrol reddeder.

# Aynı RDS'te ayrı veritabanı/kullanıcı
KC_DB_URL=jdbc:postgresql://10.20.1.10:5432/keycloak?sslmode=verify-full&sslrootcert=/etc/yanimda/tls/ca.pem
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=CHANGE_ME
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
# Realm e-postaları (STARTTLS 587, kimlik doğrulamalı)
YANIMDA_KC_SMTP_HOST=smtp.example.com
YANIMDA_KC_SMTP_PORT=587
YANIMDA_KC_SMTP_FROM=noreply@staging.yanimda.example
YANIMDA_KC_SMTP_USER=CHANGE_ME
YANIMDA_KC_SMTP_PASSWORD=CHANGE_ME
# consumers realm hizmet hesabı istemci sırları (tıklamasız kurulum). AYNI değerler: API'de
# .env.prod.api KEYCLOAK_SIGNUP_CLIENT_SECRET, sondada .env.prod.synthetic SYNTHETIC_CLIENT_SECRET (ön kontrol eşler).
# Üret: openssl rand -hex 32
YANIMDA_SIGNUP_CLIENT_SECRET=CHANGE_ME_openssl_rand_hex_32
YANIMDA_SYNTHETIC_CLIENT_SECRET=CHANGE_ME_openssl_rand_hex_32
