# T-083 ters vekil: otomatik TLS (ACME), HTTP→HTTPS, HTTP/3. Ortam: DOMAIN, ACME_EMAIL, KC_ADMIN_ALLOW_CIDRS.
# Metrik portları (API :9464, Keycloak :9000) burada YAYINLANMAZ; Grafana/Prometheus yalnız SSH tüneliyle.
{
	email {$ACME_EMAIL}
	admin 127.0.0.1:2019
	servers {
		protocols h1 h2 h3
	}
}

# T-081 (ASVS 9.1.2, 9.1.3): yalnız TLS 1.2/1.3; 1.2'de yalnız ileri gizlilikli (ECDHE) AEAD takımları. TLS 1.3
# takımları Go'da sabit (AES-GCM, ChaCha20-Poly1305). OCSP zımbalama Caddy varsayılanı (CA OCSP sunuyorsa; Let's
# Encrypt 2025'te OCSP'yi bıraktı, iptal CRL ile). Gerçek ortamda testssl.sh ile doğrulanır (docs/security/altyapi-kanit.md).
(tls_policy) {
	tls {
		protocols tls1.2 tls1.3
		ciphers TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384 TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384 TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256 TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256 TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256 TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256
		curves x25519 secp256r1 secp384r1
	}
}

(security_headers) {
	import tls_policy
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}
}

# API kopyaları Docker DNS'ten (api → 2 IP) dinamik çözülür, sırayla dağıtılır; yanıt vermeyen kopya 30 sn atlanır.
(api_upstream) {
	reverse_proxy {
		dynamic a {
			name api
			port 3000
			refresh 10s
		}
		lb_policy round_robin
		lb_try_duration 5s
		fail_duration 30s
		# Node http sunucusu boştaki bağlantıyı 5 sn'de kapatır (keepAliveTimeout); vekil bağlantıyı daha önce bırakmazsa
		# kapanmakta olan bağlantıya istek yazılır → EOF/502 (T-080 yük testinde %1,8 EOF). Vekil 4 sn'de bırakır.
		transport http {
			keepalive 4s
		}
	}
}

api.{$DOMAIN} {
	import security_headers
	encode zstd gzip
	import api_upstream
}

# Konsol: statik dosyalar + aynı kökenden /v1 (REST + WebSocket /v1/ws/queue) → CORS gerekmez.
# T-081 CSP (ASVS 14.4.3): satır içi betik yok (Vite derlemesi); stil özniteliği (React style) için yalnız
# style-src 'unsafe-inline'. Keycloak (auth.) giriş/yenileme; Twilio Voice SDK sinyal (wss) ve zil sesleri.
console.{$DOMAIN} {
	import security_headers
	header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' wss://console.{$DOMAIN} https://auth.{$DOMAIN} https://*.twilio.com wss://*.twilio.com; media-src 'self' blob: https://sdk.twilio.com https://media.twiliocdn.com; frame-src https://auth.{$DOMAIN}; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https://auth.{$DOMAIN}; frame-ancestors 'none'"
	encode zstd gzip
	handle /v1/* {
		import api_upstream
	}
	handle {
		reverse_proxy console:8080
	}
}

# Aile web (isteğe bağlı compose profili). Çalışmıyorsa 502 döner.
aile.{$DOMAIN} {
	import security_headers
	# Next.js satır içi betik üretir (nonce'suz tam CSP kırar); en az: çerçeveleme, eklenti ve base yok.
	header Content-Security-Policy "frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
	encode zstd gzip
	handle /v1/* {
		import api_upstream
	}
	handle {
		reverse_proxy family-web:8080
	}
}

# Keycloak. Yönetim konsolu yalnız izinli CIDR'lerden (varsayılan: hiçbiri).
auth.{$DOMAIN} {
	import security_headers
	@admin {
		path /admin /admin/*
		not remote_ip {$KC_ADMIN_ALLOW_CIDRS:127.0.0.1/32}
	}
	respond @admin 403
	reverse_proxy keycloak:8080
}

# Durum sayfası (Uptime Kuma, izleme compose'unda; aynı "yanimda" ağı).
status.{$DOMAIN} {
	import security_headers
	reverse_proxy uptime-kuma:3001
}
