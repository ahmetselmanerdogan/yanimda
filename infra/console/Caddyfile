# Konsol statik sunucusu (kapta, root değil, :8080). TLS ve /v1 yönlendirmesi dıştaki Caddy/Ingress'te.
{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	root * /srv
	encode zstd gzip
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"
	# PWA: service worker her zaman taze (güncelleme gecikmesin), manifest kısa önbellek.
	header /sw.js Cache-Control "no-cache"
	header /sw.js Service-Worker-Allowed "/"
	header /manifest.webmanifest Content-Type "application/manifest+json"
	try_files {path} /index.html
	file_server
}
