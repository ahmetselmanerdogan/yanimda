# Konsol statik sunucusu (kapta, root değil, :8080). TLS ve /v1 yönlendirmesi dıştaki Caddy/Ingress'te.
# Tek imaj, ortam başına yapılandırma: /config.json kap ortamından yapılandırma yüklenirken üretilir
# (CONSOLE_OIDC_AUTHORITY zorunlu, CONSOLE_OIDC_CLIENT_ID varsayılan "console", CONSOLE_API_BASE boş = aynı köken /v1);
# konsol açılmadan önce okur (apps/console/src/lib/config.ts).
{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	root * /srv
	encode zstd gzip
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"
	# PWA: service worker her zaman taze (güncelleme gecikmesin), manifest kısa önbellek.
	header /sw.js Cache-Control "no-cache"
	header /sw.js Service-Worker-Allowed "/"
	header /manifest.webmanifest Content-Type "application/manifest+json"
	handle /config.json {
		header Cache-Control "no-store"
		header Content-Type "application/json"
		respond `{"oidcAuthority":"{$CONSOLE_OIDC_AUTHORITY}","oidcClientId":"{$CONSOLE_OIDC_CLIENT_ID:console}","apiBase":"{$CONSOLE_API_BASE}"}` 200
	}
	handle {
		try_files {path} /index.html
		file_server
	}
}
