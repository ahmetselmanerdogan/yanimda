# T-083 staging/üretim ortam şablonu. Kopyala: cp infra/.env.prod.example infra/.env.prod && chmod 600 infra/.env.prod
# Gerçek değerler YALNIZ VPS'te (veya sır yöneticisinde); bu dosyada yalnız ad ve yer tutucu.
# Hem compose değişken çözümü (--env-file) hem api/worker kaplarının ortamı (env_file) bu dosyadan gelir.

# --- Dağıtım ---
ENVIRONMENT=staging
DOMAIN=staging.yanimda.example
ACME_EMAIL=ops@yanimda.example
API_IMAGE=ghcr.io/example/yanimda-api:0.0.0
CONSOLE_IMAGE=ghcr.io/example/yanimda-console:0.0.0-staging
FAMILY_WEB_IMAGE=yanimda/family-web:placeholder
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.0
# off: yalnız "worker" outbox'ı işler; on: API kopyaları sıcak yedek (kira ile tek aktif)
API_OUTBOX_WORKER=off
# Keycloak yönetim konsoluna izinli CIDR'ler (boşluklu liste)
KC_ADMIN_ALLOW_CIDRS=203.0.113.10/32
# T-081: yönetilen RDS + DCS sunucu CA paketi (PEM; sağlayıcı konsolundan indirilir). Mutlak yol: iki compose dosyası da
# kullanır. Postgres verify-full, rediss://, Keycloak JDBC ve dışa aktarıcılar bu dosyayla sunucuyu doğrular.
INTERNAL_CA_FILE=/srv/yanimda/tls/ca.pem

# --- API (apps/api; ayrıntı: kök .env.example) ---
NODE_ENV=production
DATABASE_URL=postgres://yanimda:CHANGE_ME@10.20.1.10:5432/yanimda?sslmode=verify-full&sslrootcert=/etc/yanimda/tls/ca.pem
DATABASE_POOL_MAX=10
DB_MIGRATE_ON_START=true
# DCS ACL hesabı (Terraform redis_app_user) + TLS
REDIS_URL=rediss://yanimda-app:CHANGE_ME@10.20.1.20:6379
OUTBOX_POLL_MS=1000
# 0038: süreç başına paralel outbox bölümü (≤ DATABASE_POOL_MAX − HTTP payı)
OUTBOX_CONCURRENCY=4
TIMERS_PREFIX=yanimda
SIMULATOR_ENABLED=false
# ADMIN_TOKEN üretimde tanımlanmaz: doluysa API açılmaz (T-081 G-4); yönetici uçları yalnız OIDC ADMIN (MFA).
DEVICE_TOKEN_SECRET=CHANGE_ME_openssl_rand_hex_32
FIELD_ENC_KEYS=k1:CHANGE_ME_base64_32_bytes
# T-060 web kaydı doğrulama token'ı imzası (≥ 32 karakter, üretimde zorunlu)
SIGNUP_TOKEN_SECRET=CHANGE_ME_at_least_32_chars
KEYCLOAK_URL=https://auth.staging.yanimda.example
OIDC_OPERATIONS_ISSUER=https://auth.staging.yanimda.example/realms/operations
OIDC_CONSUMERS_ISSUER=https://auth.staging.yanimda.example/realms/consumers
OIDC_AUDIENCE=yanimda-api
OIDC_REQUIRE_MFA=true
METRICS_HOST=0.0.0.0
COUNTRY_CODE=TR
OPERATOR_LOCK_SEC=300
S3_ENDPOINT=https://obs.tr-west-1.myhuaweicloud.com
S3_BUCKET=yanimda-staging-recordings
S3_REGION=tr-west-1
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_ENSURE_BUCKET=false
RECORDING_RETENTION_DAYS=30
CPAAS_PROVIDER=twilio
CPAAS_WEBHOOK_BASE=https://api.staging.yanimda.example
CPAAS_AGENT_NUMBER=
CPAAS_SOFTPHONE=on
TWILIO_ACCOUNT_SID=CHANGE_ME
TWILIO_AUTH_TOKEN=CHANGE_ME
TWILIO_FROM_NUMBER=+900000000000
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
GOOGLE_GEOCODING_KEY=
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_TOPIC=app.yanimda.companion

# --- Keycloak (aynı RDS'te ayrı veritabanı/kullanıcı) ---
KC_DB_URL=jdbc:postgresql://10.20.1.10:5432/keycloak?sslmode=verify-full&sslrootcert=/etc/yanimda/tls/ca.pem
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=CHANGE_ME
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
# Realm e-postaları (STARTTLS 587, kimlik doğrulamalı)
KC_SMTP_HOST=smtp.example.com
KC_SMTP_PORT=587
KC_SMTP_FROM=noreply@staging.yanimda.example
KC_SMTP_USER=CHANGE_ME
KC_SMTP_PASSWORD=CHANGE_ME
# Boş: infra/keycloak/password-blacklists (tohum). İhlal listesiyle birleştirilmiş dizin: infra/README.md "Kara liste"
KC_BLACKLIST_DIR=

# --- Sentetik sonda (infra/synthetic/probe.mjs) ---
SYNTHETIC_CLIENT_ID=yanimda-synthetic
SYNTHETIC_CLIENT_SECRET=CHANGE_ME
# Virgüllü SENTETİK kişi kimlikleri (en az 3: 10 dk test bekleme süresi + açık olay engeli; README "Sentetik")
SYNTHETIC_PERSON_IDS=00000000-0000-7000-8000-000000000001,00000000-0000-7000-8000-000000000002,00000000-0000-7000-8000-000000000003
SYNTHETIC_INTERVAL_SEC=300
SYNTHETIC_TIMEOUT_SEC=60
UPTIME_KUMA_PUSH_URL=
PUSHGATEWAY_URL=http://pushgateway:9091

# --- Yedek (infra/backup) ---
BACKUP_DATABASE_URL=postgres://yanimda_backup:CHANGE_ME@10.20.1.10:5432/yanimda?sslmode=verify-full&sslrootcert=/etc/yanimda/tls/ca.pem
BACKUP_S3_BUCKET=yanimda-staging-backups
BACKUP_S3_ENDPOINT=https://obs.tr-west-1.myhuaweicloud.com
BACKUP_S3_REGION=tr-west-1
BACKUP_S3_PREFIX=pg/staging
BACKUP_S3_ACCESS_KEY=CHANGE_ME
BACKUP_S3_SECRET_KEY=CHANGE_ME
BACKUP_RETENTION_DAYS=35
BACKUP_AT=03:15

# --- İzleme (infra/monitoring) ---
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
# postgres_exporter: salt okunur izleme kullanıcısı (README "İzleme kullanıcısı")
PG_EXPORTER_DSN=postgresql://yanimda_monitor:CHANGE_ME@10.20.1.10:5432/yanimda?sslmode=verify-full&sslrootcert=/etc/yanimda/tls/ca.pem
REDIS_EXPORTER_ADDR=rediss://10.20.1.20:6379
# DCS salt okunur ACL hesabı (Terraform redis_monitor_user)
REDIS_EXPORTER_USER=yanimda-monitor
REDIS_EXPORTER_PASSWORD=CHANGE_ME
