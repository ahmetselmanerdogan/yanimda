NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://yanimda:yanimda@localhost:5432/yanimda
DATABASE_POOL_MAX=10
# Postgres bağlantı / sorgu zaman aşımı (ms). Asılı bağlantı outbox işçisini durdurmasın (failover). Migration hariç.
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_QUERY_TIMEOUT_MS=30000
# Açılışta migration (prod'da false yapıp `pnpm --filter @yanimda/api db:migrate` çalıştırılabilir)
DB_MIGRATE_ON_START=true
REDIS_URL=redis://localhost:6379
# Outbox işçisi (T-010): yoklama aralığı ms; OUTBOX_WORKER=off yalnız API örneği (işçi ayrı süreçte)
OUTBOX_POLL_MS=1000
OUTBOX_WORKER=on
# Zamanlayıcılar (T-013, BullMQ): Redis anahtar öneki
TIMERS_PREFIX=yanimda
# Taramalar (T-011b/T-012/T-014): gecikmiş soru, sessiz cihaz, koruma durumu — aralık ve pay (ms); 0 = kapalı
EVENT_SWEEP_MS=30000
# T-070 öğrenme modu günlük işi (saatlik tarama; kişi başına günde bir öğrenme). 0 = kapalı.
LEARNING_SWEEP_MS=3600000
EVENT_SWEEP_GRACE_MS=20000
# Kural paketi (T-012): diğer örneklerin yüklediği sürümü alma aralığı (ms)
RULES_REFRESH_MS=30000
# Yönetici uçları (kural yükleme, davet, cihaz kaldırma): OIDC ADMIN rolü veya betikler/CI için x-admin-token = ADMIN_TOKEN.
# Boşsa yalnız OIDC.
ADMIN_TOKEN=
# Cihaz token imza anahtarı (T-041, HS256, en az 32 karakter). Üretimde zorunlu; boşsa geliştirmede süreç başına
# rastgele (API yeniden başlayınca cihazlar yeniden eşleşmeli). Üret: openssl rand -hex 32
DEVICE_TOKEN_SECRET=
# Alan şifreleme (T-040; kapı notu, tıbbi özet; AES-256-GCM). "kid:<base64 32 bayt>[,eskiKid:<…>]": ilki yazar,
# hepsi okur (anahtar döndürme). Üretimde zorunlu (KMS'ten); boşsa geliştirmede süreç başına geçici anahtar (API
# yeniden başlayınca kayıtlı şifreli alanlar okunamaz). Üret: echo "k1:$(openssl rand -base64 32)"
FIELD_ENC_KEYS=
# Adres doğrulama (T-040, Google Geocoding). Boşsa adres konumlanmaz (aile uygulaması harita iğnesi gönderebilir).
GOOGLE_GEOCODING_KEY=
# FCM HTTP v1 (T-053; Android saat/telefon ve aile uygulaması push). Hizmet hesabı: FCM_CREDENTIALS_FILE (JSON)
# veya FCM_PROJECT_ID + FCM_CLIENT_EMAIL + FCM_PRIVATE_KEY (PEM, \n kaçışlı). Boşsa push gönderilmez; aile
# bildirimleri SMS yedeğine düşer.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
FCM_CREDENTIALS_FILE=
# Bildirim dağıtıcısının tarama aralığı (ms; yeniden deneme ve 10 sn SMS yedeği). 0 = kapalı (testler).
NOTIFY_SWEEP_MS=2000
# Amir panosunun WS itme aralığı (T-074; ms). 0 = kapalı (konsol yine REST ile ilk yüklemeyi yapar).
SUPERVISOR_PUSH_MS=5000
# Günlük özet taraması (T-062; ms). Her kişi kendi saat diliminde 00:30 sonrası dünün özeti, 20:00–22:00 F-DAILY.
# 0 = kapalı.
DAILY_SWEEP_MS=300000
# Kayıtsız cihaz / simülatör sinyalleri ve token'sız POST /signals (T-015, T-041). Boşsa NODE_ENV !== production
# iken açık. Üretimde false.
SIMULATOR_ENABLED=
# Operatör kilidi (T-021, D-04) saniye: her operatör isteği uzatır; dolunca olay kuyruğa döner + amir uyarısı.
OPERATOR_LOCK_SEC=300
# Prometheus metrikleri (T-025): ayrı portta /metrics; yalnız iç ağa açın (boş/0 = kapalı). Pano: infra/grafana/konsol.json
METRICS_PORT=9464
METRICS_HOST=0.0.0.0
# v2.0 (Kafka) — v1.0'da kullanılmaz
KAFKA_BROKERS=localhost:19092
# Kimlik (T-020): Keycloak. Issuer'lar boşsa KEYCLOAK_URL/realms/{operations,consumers}. İkisi de yoksa kullanıcı
# girişi gereken uçlar 401 döner. operations realm token'ında amr içinde "otp" zorunlu (üretimde kapatılamaz).
KEYCLOAK_URL=http://localhost:8080
OIDC_OPERATIONS_ISSUER=
OIDC_CONSUMERS_ISSUER=
OIDC_AUDIENCE=yanimda-api
OIDC_REQUIRE_MFA=true
# Görüşme kayıtları (T-050): S3 uyumlu depo, nesne kilidi (COMPLIANCE). Üretimde Twilio ile zorunlu.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=recordings
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Kayıt saklama (gün; nesne kilidi süresi). Hukuki süre KVKK değerlendirmesiyle belirlenmeli.
RECORDING_RETENTION_DAYS=365
# Geliştirme: kovayı nesne kilidiyle oluştur (üretimde kova altyapıyla kurulur)
S3_ENSURE_BUCKET=false
# Telefoni (T-050): twilio | fake (geliştirmede varsayılan; üretimde yasak) | off
CPAAS_PROVIDER=fake
# Sağlayıcının eriştiği genel API kökü (webhook adresleri ve imza bu adresle hesaplanır)
CPAAS_WEBHOOK_BASE=http://localhost:3000
# Operatör ucu (T-051): yazılım telefonu açıksa konsol (`client:<operatör>`), değilse bu masa hattı (E.164).
# T-052: aynı zamanda masa sabit hattı — 112 bu hattan elle aranır; konsol 112 adımında geri arama numarası olarak gösterir.
CPAAS_AGENT_NUMBER=
# T-052 servisin gelen SOS numarası (saatlerin aradığı; E.164, ör. +90850…) ve yedeği. Bilgi/doğrulama amaçlı:
# yönlendirme Twilio numarasının (ya da BYOC trunk'ın) Voice URL'i ile yapılır:
#   Voice URL          → POST {CPAAS_WEBHOOK_BASE}/v1/webhooks/cpaas-inbound/call
#   Status callback    → POST {CPAAS_WEBHOOK_BASE}/v1/webhooks/cpaas-inbound/status
CPAAS_INBOUND_NUMBER=
CPAAS_BACKUP_NUMBER=
# Gelen SOS yönlendirmesi (T-051 kalan): operatör başına çalma süresi (5–60 sn), cevapsız operatörün yeniden
# denenmesi (0–600 sn), kuyrukta bekleme anonsu arası sessizlik (1–60 sn).
INBOUND_RING_SEC=20
INBOUND_RETRY_SEC=30
INBOUND_WAIT_PAUSE_SEC=8
# Asılı giden arama: queued/ringing satırı son durum değişiminden bu kadar sonra (sn), in-progress başlangıçtan
# en çok bu kadar sonra (sn) bitmiş sayılır — "Ara" yeniden arar, operatör gelen SOS'ta meşgul sayılmaz; tarama
# (ms, 0 kapalı) satırı failed/stale + audit telephony.call.stale ile kapatır.
CALL_SETUP_STALE_SEC=120
CALL_MAX_DURATION_SEC=7200
CALL_SWEEP_MS=60000
# Konsol yazılım telefonu (T-051): on (varsayılan; sahte sağlayıcıda ya da Twilio API anahtarı varsa) | off (masa hattı)
CPAAS_SOFTPHONE=on
# Sahte CPaaS adım süresi (ms)
FAKE_CPAAS_STEP_MS=700
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Arayan numara (E.164). COUNTRY_CODE=TR iken TR dışı numara açılışta uyarı verir (kabul aramaları TR numarasından).
TWILIO_FROM_NUMBER=
# T-052 SIP trunk: Netgsm/Verimor trunk'ı Twilio BYOC ile bağlıysa BYOC Trunk SID (BY + 32 hex). Verilirse PSTN
# bacakları (aranan, konferansa eklenen yakın, sesli bildirim, masa hattı) bu trunk'tan çıkar. Boşsa Twilio numarası.
TWILIO_BYOC_TRUNK_SID=
# T-054 eşlikçi telefon: operatörün arayan numaraları (virgüllü E.164; boşsa TWILIO_FROM_NUMBER). Telefon bu
# numaradan gelen aramayı hoparlöre alır ve rehbere "Yanımda" adıyla ekler. Ana ekranda gösterilen operatör adı.
OPERATOR_CALLER_IDS=
OPERATOR_DISPLAY_NAME=
# Yazılım telefonu (T-051): Twilio Console → API keys (Standard). Voice token'ı bu anahtarla imzalanır.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# İsteğe bağlı: tarayıcıdan giden arama için TwiML App (şimdilik yalnız gelen köprü bacağı kullanılır)
TWILIO_TWIML_APP_SID=
# Voice token ömrü (sn, 60–3600)
TWILIO_VOICE_TOKEN_TTL_SEC=3600
FCM_SERVER_KEY=
# APNs (T-053 cihaz tarafı, iPhone uyandırma). Apple Developer → Keys → APNs anahtarı (.p8). Boşsa iPhone'a push
# gitmez (geliştirmede kaydedilir). APNS_PRIVATE_KEY: PEM, satır sonları \n olabilir; veya APNS_PRIVATE_KEY_FILE.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_PRIVATE_KEY_FILE=
APNS_TOPIC=app.yanimda.companion
# Sessiz kalmış (10 dk+) iPhone'ları uyandırma aralığı ms (0 = kapalı). Apple arka plan push'unu saatte birkaç tane ile sınırlar.
PUSH_WAKE_MS=900000
COUNTRY_CODE=TR
# Web abonelik ve ödeme (T-060). PAYMENT_PROVIDER: live | fake (geliştirmede anahtar yoksa varsayılan; üretimde yasak).
# live: TR → iyzico, US → Stripe; anahtarı olmayan ülkede kayıt 503. Fiyatlar sağlayıcı panosunda (plan kodu başına).
PAYMENT_PROVIDER=
# iyzico (TR) — sandbox: https://sandbox-api.iyzipay.com · canlı: https://api.iyzipay.com
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_MERCHANT_ID=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
# iyzico fiyat planı referans kodları (pricingPlanReferenceCode)
IYZICO_PLAN_STANDARD=
IYZICO_PLAN_STANDARD_YEARLY=
# Stripe (US) — test anahtarı sk_test_…, webhook sırrı whsec_… (stripe listen / panodaki uç)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_STANDARD_YEARLY=
# Sahte sağlayıcının webhook imza sırrı (yalnız geliştirme; boşsa yerleşik test sırrı)
FAKE_PAYMENT_SECRET=
# Keycloak consumers hesabı açan hizmet hesabı istemcisi (realm-consumers.json `yanimda-signup`; sırrı
# `node infra/keycloak/dev-users.mjs` yazdırır). Boşsa geliştirmede hesaplar bellekte (sahte), üretimde kayıt kapalı.
KEYCLOAK_SIGNUP_CLIENT_ID=yanimda-signup
KEYCLOAK_SIGNUP_CLIENT_SECRET=
KEYCLOAK_CONSUMERS_REALM=consumers
# E-posta doğrulama / parola belirleme bağlantısının döneceği istemci
KEYCLOAK_FAMILY_CLIENT_ID=family-web
# Kayıt akışı token'ı imza anahtarı (en az 32 karakter; üretimde zorunlu). Üret: openssl rand -hex 32
SIGNUP_TOKEN_SECRET=
# Aile web kökü (ödeme dönüş adresleri) ve sağlayıcının eriştiği genel API kökü (iyzico callback)
FAMILY_WEB_URL=http://localhost:5175
PUBLIC_API_URL=http://localhost:3000
# KVKK aydınlatma metni sürümü (web aynı sürümü gönderir; değişince eski sürümle kayıt 400). Metinler hukuk onayı bekliyor.
KVKK_NOTICE_VERSION=taslak-2026-11
# Deneme / ödeme bekleme taraması (ms). 0 = kapalı.
BILLING_SWEEP_MS=60000
# Geliştirmede sahte SMS ile doğrulama kodu yanıtta döner; off = dönmez
SIGNUP_DEV_CODE=
# Amir uyarısı / üstlenme SLA taraması (ms; 0 = kapalı).
ALERT_SWEEP_MS=5000
# T-087 merdiven taraması (ms; 0 = kapalı): 90 sn üstlenilmeyen P1 → amir (O-P1-UNCLAIMED); kural paketinde
# ladder.unclaimedVoiceContact açıksa 180 sn'de 1. yakına sesli mesaj. Süreler packages/rules/tr.yaml'da.
LADDER_SWEEP_MS=5000
# Kuyruktaki düzenli arama üst sınırı (aşılınca yeni dönem ertelenir).
WELLNESS_MAX_CONCURRENT=5

# Personel web push (PWA; amir uyarıları telefona/masaüstüne). Anahtar üretimi: `npx web-push generate-vapid-keys`.
# Boşsa web push kapalı. Özel anahtar sırdır (kasada tutulur).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:destek@yanimda.app
# Düzenli "yanınızdayız" araması taraması (ms; 0 = kapalı) ve 112 süreç takibi (dk).
WELLNESS_SWEEP_MS=60000
DISPATCH_ARRIVAL_SLA_MIN=15
DISPATCH_OPEN_REMIND_MIN=60
# T-081: ters vekil atlama sayısı (Caddy / ingress arkasında 1). 0 = istemci IP'si doğrudan soketten.
TRUST_PROXY=0
# T-081 hız sınırı (Redis; Redis yoksa açık kalır). off = kapalı (yalnız yük testi). Alarm sinyalleri hiç sayılmaz.
RATE_LIMIT=
# T-092 değer kuralları (docs/07 S6) — BAYRAKLA KAPALI. Boş: kural paketi (packages/rules/tr.yaml vitals.enabled,
# varsayılan false). true / false paketi geçersiz kılar. Yazılı mevzuat görüşü alınmadan üretimde true yapılmaz.
VITALS_ENABLED=
# Değer taraması (ms; 0 = kapalı): üstlenme hedefi, ulaşılamama geçişi; saatte bir günlük özet, taban çizgisi ve
# saklama süreleri (ham 30 gün, özet 13 ay — saklama bayraktan bağımsız çalışır).
VITALS_SWEEP_MS=60000
# T-081 (ASVS 8.3.8) saklama süreleri, gün; 0 = o sınıfın temizliği kapalı. docs/security/saklama.md. Boş = varsayılan.
# Tabanın altındaki değer (0 hariç) açılışı durdurur. audit.log hiç silinmez (append-only); görüşme kaydı
# RECORDING_RETENTION_DAYS, değer verisi VITALS_SWEEP_MS turunda (kural paketi vitals.retention).
# Ham sinyal (varsayılan 400, en az 35) ve sinyaldeki konum alanı (30, en az 1; satır kalır, konum düşer).
SIGNAL_RETENTION_DAYS=
SIGNAL_LOCATION_RETENTION_DAYS=
# Günlük özet (400, en az 31); işlenmiş outbox satırları (7, en az 1; DLQ ve ölü side satırı asla silinmez).
DAILY_SUMMARY_RETENTION_DAYS=
OUTBOX_RETENTION_DAYS=
# Süresi dolmuş davet kodları (son geçerlilikten sonra 30); son durumdaki bildirim kayıtları (365, en az 30);
# ortak webhook nonce kaydı (7; imza penceresi ±5 dk).
INVITE_RETENTION_DAYS=
NOTIFICATION_RETENTION_DAYS=
PARTNER_NONCE_RETENTION_DAYS=
# Temizlik turu aralığı (ms; varsayılan 6 saat, 0 = kapalı). Birden çok örnekte tek örnek çalışır (advisory lock).
RETENTION_SWEEP_MS=
# T-092 BLE köprülü cihaz adres özeti için sunucu anahtarı (HMAC, en az 32 karakter; ham MAC hiç gelmez). Boşsa
# DEVICE_TOKEN_SECRET kullanılır; değiştirilirse mevcut köprülü cihazlar yeniden kayıtta yeni kimlik alır.
# Üret: openssl rand -hex 32
BLE_ADDRESS_PEPPER=

# T-085 OEM ortak cihazları (docs/07 S2.5–S2.7). Ortak webhook sırrı: PARTNER_<KOD>_WEBHOOK_SECRET (HMAC-SHA256,
# POST /v1/webhooks/partners/<KOD>); boşsa o ortağın webhook'u 404. Sahte ortak FAKE_PENDANT (test / simülatör)
# üretimde yalnız PARTNER_FAKE_ENABLED=true ile açılır. Üret: openssl rand -hex 32
PARTNER_FAKE_PENDANT_WEBHOOK_SECRET=
PARTNER_FAKE_ENABLED=
# Ortak gecikmesi taraması (ms; O-OEM-LATENCY, kapsamada "zayıf") ve kolye aylık test hatırlatması taraması (ms).
# 0 = kapalı.
PARTNER_SWEEP_MS=60000
MAINTENANCE_SWEEP_MS=3600000
