# T-060 aile web (Next.js). Sır yok: hepsi genel değer.
# API kökü (sunucu tarafı rewrite; tarayıcı /v1/* ile aynı kökten gider)
API_URL=http://localhost:3000
# Keycloak consumers realm ve aile web istemcisi (PKCE, genel istemci) — "Aboneliğim" girişi
NEXT_PUBLIC_OIDC_ISSUER=http://localhost:8080/realms/consumers
NEXT_PUBLIC_OIDC_CLIENT_ID=family-web
# Uygulama mağaza bağlantıları (adım 3). Uygulamalar yayınlanana kadar boş: düğmeler gizlenir.
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=
