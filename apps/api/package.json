{
  "name": "@yanimda/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "tsx src/db/cli.ts migrate",
    "db:rollback": "tsx src/db/cli.ts rollback",
    "db:seed": "tsx src/db/cli.ts seed",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "stack:local": "tsx test/e2e/stack-cli.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.4",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "@yanimda/contracts": "workspace:*",
    "@yanimda/messages": "workspace:*",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "bullmq": "^5",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^5.11.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^10.0.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@electric-sql/pglite-socket": "0",
    "@types/ioredis-mock": "^8.2.8",
    "@types/node": "^22.7.0",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^10.0.0",
    "@yanimda/simulator": "workspace:^",
    "ioredis-mock": "^8.13.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.2"
  }
}
