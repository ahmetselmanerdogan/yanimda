{
  "name": "@yanimda/console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:layout": "playwright test -c playwright.layout.config.ts",
    "lint": "eslint src e2e",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@twilio/voice-sdk": "2.18.5",
    "@yanimda/contracts": "workspace:*",
    "@yanimda/messages": "workspace:*",
    "@yanimda/ui-tokens": "workspace:*",
    "oidc-client-ts": "3.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "^5.6.0",
    "vite": "8.3.6",
    "vitest": "^5.1.0"
  }
}
