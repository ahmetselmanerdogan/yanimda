# Operatör konsolu (T-023). Vite yalnız VITE_ önekli değişkenleri tarayıcıya verir; sır yazmayın.
# Keycloak operations realm'i ve genel (public) PKCE istemcisi
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/operations
VITE_OIDC_CLIENT_ID=console
# API tabanı (boşsa aynı köken /v1; geliştirmede Vite proxy'si)
VITE_API_BASE=
# Geliştirme sunucusu: /v1 proxy hedefi ve port
CONSOLE_API_PROXY=http://localhost:3000
CONSOLE_PORT=5173
