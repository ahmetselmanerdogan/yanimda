{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RulePack",
  "type": "object",
  "required": ["country", "version", "rules"],
  "properties": {
    "country": { "type": "string", "minLength": 2, "maxLength": 2 },
    "version": { "type": "integer", "minimum": 1 },
    "learning": {
      "description": "D-06 öğrenme modu (T-070): süre, günlük işin baktığı geçmiş, en az veri günü, hareketsizlik yüzdeliği",
      "type": "object",
      "required": ["days", "historyDays", "minDays", "inactivityPercentile"],
      "properties": {
        "days": { "type": "integer", "minimum": 1, "maximum": 180 },
        "historyDays": { "type": "integer", "minimum": 1, "maximum": 60 },
        "minDays": { "type": "integer", "minimum": 1 },
        "inactivityPercentile": { "type": "integer", "minimum": 50, "maximum": 100 }
      },
      "additionalProperties": false
    },
    "numbers": {
      "description": "T-052 resmi hatlar: acil (112), sosyal destek (183), sağlık (182); masa sabit hattından aranır",
      "type": "object",
      "required": ["emergency", "social", "health"],
      "properties": {
        "emergency": { "type": "string", "pattern": "^[0-9]{3,4}$" },
        "social": { "type": "string", "pattern": "^[0-9]{3,4}$" },
        "health": { "type": "string", "pattern": "^[0-9]{3,4}$" }
      },
      "additionalProperties": false
    },
    "falseAlarm": {
      "description": "D-07 yanlış alarm (T-071): pencere ve eşik görüşmesini tetikleyen tekrar sayısı",
      "type": "object",
      "required": ["windowDays", "reviewAfter"],
      "properties": {
        "windowDays": { "type": "integer", "minimum": 1, "maximum": 365 },
        "reviewAfter": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "call112DeadlineSec": {
      "description": "docs/07 S5.2/S5.4 (T-087): kuyruğa düşüşten 112 son sınırı (sn), olay türüne göre",
      "type": "object",
      "propertyNames": { "enum": ["SOS", "FALL", "INACTIVITY"] },
      "additionalProperties": { "type": "integer", "minimum": 30, "maximum": 7200 }
    },
    "ladder": {
      "description": "docs/07 S5 (T-087) ulaşılamama merdiveni",
      "type": "object",
      "properties": {
        "autoAnswerSec": { "type": "integer", "minimum": 0, "maximum": 60 },
        "unclaimedSupervisorSec": { "type": "integer", "minimum": 10, "maximum": 600 },
        "unclaimedVoiceContact": {
          "type": "object",
          "required": ["enabled", "afterSec", "phrase"],
          "properties": {
            "enabled": { "type": "boolean" },
            "afterSec": { "type": "integer", "minimum": 60, "maximum": 1800 },
            "phrase": { "type": "string", "pattern": "^V-[A-Z0-9-]+$" }
          },
          "additionalProperties": false
        },
        "awayFromHomeM": { "type": "integer", "minimum": 50, "maximum": 10000 },
        "operatorPrompt": {
          "description": "T-089 operatörün \"Soru gönder\" komutu (olay türünün cihaz sorusu yoksa)",
          "type": "object",
          "required": ["windowSec", "tts"],
          "properties": {
            "windowSec": { "type": "integer", "minimum": 10, "maximum": 300 },
            "tts": { "type": "string", "pattern": "^W-[A-Z0-9-]+$" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "fusion": {
      "description": "docs/07 S3.3–S3.7 (T-088) sinyal birleştirme",
      "type": "object",
      "properties": {
        "corroborateSec": { "type": "integer", "minimum": 10, "maximum": 600 },
        "corroboratedPromptSec": { "type": "integer", "minimum": 10, "maximum": 120 },
        "crossCancelFollowUp": { "type": "boolean" },
        "crossCancelFollowUpMin": { "type": "integer", "minimum": 5, "maximum": 720 },
        "gpsFreshSec": { "type": "integer", "minimum": 10, "maximum": 1800 }
      },
      "additionalProperties": false
    },
    "coverage": {
      "description": "T-085 (S3.2): cihaz bu kadar dk görülmezse çevrimdışı (sınıfa göre); konum bu kadar dk'dan eskiyse zayıf",
      "type": "object",
      "required": ["onlineMin"],
      "properties": {
        "onlineMin": {
          "type": "object",
          "required": ["A", "B"],
          "properties": {
            "A": { "type": "integer", "minimum": 1, "maximum": 240 },
            "B": { "type": "integer", "minimum": 1, "maximum": 240 }
          },
          "additionalProperties": false
        },
        "locationStaleMin": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "battery": {
      "description": "T-086 (S4.2, S4.6): pil eşikleri (%); planHour planlı şarj kontrolü (kişinin saat diliminde)",
      "type": "object",
      "required": ["warnPct", "planPct", "familyPct", "criticalPct", "deadPct", "planHour"],
      "properties": {
        "warnPct": { "type": "integer", "minimum": 1, "maximum": 100 },
        "planPct": { "type": "integer", "minimum": 1, "maximum": 100 },
        "familyPct": { "type": "integer", "minimum": 1, "maximum": 100 },
        "criticalPct": { "type": "integer", "minimum": 1, "maximum": 100 },
        "deadPct": { "type": "integer", "minimum": 0, "maximum": 100 },
        "planHour": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" }
      },
      "additionalProperties": false
    },
    "charging": {
      "description": "T-086 (S4.3–S4.5): şarj penceresi ve şarj boşluğu zamanlayıcıları (uyanık dakika)",
      "type": "object",
      "required": [
        "defaultWindow",
        "chargeDonePct",
        "chargeDoneMin",
        "putOnMin",
        "familyGapMin",
        "familyGapOffPlanMin",
        "maxGapMin",
        "intentMin"
      ],
      "properties": {
        "defaultWindow": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]-([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "chargeDonePct": { "type": "integer", "minimum": 1, "maximum": 100 },
        "chargeDoneMin": { "type": "integer", "minimum": 0 },
        "putOnMin": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "type": "integer", "minimum": 1 } },
        "familyGapMin": { "type": "integer", "minimum": 1 },
        "familyGapOffPlanMin": { "type": "integer", "minimum": 1 },
        "maxGapMin": { "type": "integer", "minimum": 1 },
        "intentMin": { "type": "integer", "minimum": 1, "maximum": 480 },
        "resumeAfterWakeMin": { "type": "integer", "minimum": 0, "maximum": 180 },
        "learn": {
          "description": "S4.3 (T-086): öğrenilmiş şarj penceresi (gün, en az geçerli gün, oturum sınırları, yuvarlama dk)",
          "type": "object",
          "properties": {
            "days": { "type": "integer", "minimum": 7, "maximum": 60 },
            "minDays": { "type": "integer", "minimum": 1, "maximum": 60 },
            "minSessionMin": { "type": "integer", "minimum": 1 },
            "maxSessionH": { "type": "integer", "minimum": 1, "maximum": 24 },
            "roundMin": { "type": "integer", "minimum": 1, "maximum": 60 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "coverageNone": {
      "description": "T-086 (S4.7): hiçbir SOS yolu yokken (uyanık) hatırlatma, aile ve KAPSAMA BOŞLUĞU (dk); welfare* T-087",
      "type": "object",
      "required": ["remindMin", "familyMin", "eventMin"],
      "properties": {
        "remindMin": { "type": "integer", "minimum": 1 },
        "familyMin": { "type": "integer", "minimum": 1 },
        "eventMin": { "type": "integer", "minimum": 1 },
        "welfareSilentH": { "type": "integer", "minimum": 1 },
        "welfareDroppedH": { "type": "integer", "minimum": 1 },
        "welfareNoMovementH": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "partner": {
      "description": "T-085 OEM (S2.7): ortak gecikmesi; p99 eşiği (sn), pencere (dk), en az örnek",
      "type": "object",
      "required": ["latencyP99Sec", "latencyWindowMin", "minSamples"],
      "properties": {
        "latencyP99Sec": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "latencyWindowMin": { "type": "integer", "minimum": 5, "maximum": 1440 },
        "minSamples": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "pendant": {
      "description": "T-085 / T-086 (S4.9): uzun ömürlü pilli kolye bakımı ve 'takılmadı' bildirimi",
      "type": "object",
      "required": [
        "longLifeBatteryH",
        "workOrderPct",
        "workOrderDaysBeforeEnd",
        "replaceWithinDays",
        "replacedPct",
        "testReminderDays",
        "notWornMinDays"
      ],
      "properties": {
        "longLifeBatteryH": { "type": "integer", "minimum": 24 },
        "workOrderPct": { "type": "integer", "minimum": 1, "maximum": 99 },
        "workOrderDaysBeforeEnd": { "type": "integer", "minimum": 1, "maximum": 365 },
        "replaceWithinDays": { "type": "integer", "minimum": 1, "maximum": 90 },
        "replacedPct": { "type": "integer", "minimum": 1, "maximum": 100 },
        "testReminderDays": { "type": "integer", "minimum": 1, "maximum": 365 },
        "notWornMinDays": { "type": "integer", "minimum": 1, "maximum": 30 }
      },
      "additionalProperties": false
    },
    "chronicGap": {
      "description": "S4.10: kronik boşluk planı (günde boşluk sayısı, kişiye özel tolerans üst sınırı, amir listesi korunma yüzdesi)",
      "type": "object",
      "properties": {
        "gaps": { "type": "integer", "minimum": 2 },
        "days": { "type": "integer", "minimum": 1, "maximum": 30 },
        "toleranceMaxMin": { "type": "integer", "minimum": 0, "maximum": 240 },
        "protectedPct": { "type": "integer", "minimum": 1, "maximum": 100 }
      },
      "additionalProperties": false
    },
    "vitals": {
      "description": "T-092 (docs/07 S6, S8.4) değer kuralları; bayrakla kapalı (enabled: false), mevzuat görüşü bekler",
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "learnDays": { "type": "integer", "minimum": 1, "maximum": 60 },
        "minValidDays": { "type": "integer", "minimum": 1, "maximum": 60 },
        "baselineDays": { "type": "integer", "minimum": 7, "maximum": 60 },
        "validDaySamples": { "type": "integer", "minimum": 1 },
        "sustainedMin": { "type": "integer", "minimum": 1, "maximum": 120 },
        "comboMin": { "type": "integer", "minimum": 1, "maximum": 60 },
        "cooldownH": { "type": "integer", "minimum": 0, "maximum": 168 },
        "worsenPct": { "type": "integer", "minimum": 1, "maximum": 100 },
        "maxChecksPerWeek": { "type": "integer", "minimum": 0, "maximum": 50 },
        "claimSlaMin": { "type": "integer", "minimum": 1, "maximum": 240 },
        "unreachableMin": { "type": "integer", "minimum": 1, "maximum": 120 },
        "agreeMin": { "type": "integer", "minimum": 1, "maximum": 30 },
        "preconditions": {
          "type": "object",
          "properties": {
            "wornMin": { "type": "integer", "minimum": 0 },
            "batteryPct": { "type": "integer", "minimum": 0, "maximum": 100 },
            "stillSteps": { "type": "integer", "minimum": 1 },
            "stillMin": { "type": "integer", "minimum": 1 },
            "minSamples": { "type": "integer", "minimum": 1, "maximum": 20 },
            "maxGapMin": { "type": "integer", "minimum": 1, "maximum": 30 },
            "hrMin": { "type": "integer", "minimum": 1 },
            "hrMax": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "hr": {
          "type": "object",
          "properties": {
            "low": { "type": "integer", "minimum": 20, "maximum": 80 },
            "belowSleepBaseline": { "type": "integer", "minimum": 0, "maximum": 40 },
            "highResting": { "type": "integer", "minimum": 90, "maximum": 220 },
            "deviationPct": { "type": "integer", "minimum": 5, "maximum": 100 },
            "deviationMin": { "type": "integer", "minimum": 1, "maximum": 240 },
            "agreePct": { "type": "integer", "minimum": 1, "maximum": 50 }
          },
          "additionalProperties": false
        },
        "spo2": {
          "type": "object",
          "properties": {
            "low": { "type": "integer", "minimum": 70, "maximum": 96 },
            "lowCopd": { "type": "integer", "minimum": 70, "maximum": 96 },
            "apartMin": { "type": "integer", "minimum": 1, "maximum": 60 },
            "comboHr": { "type": "integer", "minimum": 80, "maximum": 220 },
            "agreePts": { "type": "integer", "minimum": 1, "maximum": 10 }
          },
          "additionalProperties": false
        },
        "skinTemp": {
          "type": "object",
          "properties": {
            "deltaC": { "type": "number", "minimum": 0.1, "maximum": 5 },
            "nights": { "type": "integer", "minimum": 1, "maximum": 7 }
          },
          "additionalProperties": false
        },
        "retention": {
          "type": "object",
          "required": ["rawDays", "summaryMonths"],
          "properties": {
            "rawDays": { "type": "integer", "minimum": 1, "maximum": 90 },
            "summaryMonths": { "type": "integer", "minimum": 1, "maximum": 36 }
          },
          "additionalProperties": false
        },
        "view": {
          "type": "object",
          "properties": {
            "windowMin": { "type": "integer", "minimum": 10, "maximum": 240 },
            "bucketMin": { "type": "integer", "minimum": 1, "maximum": 30 }
          },
          "additionalProperties": false
        },
        "trendCode": { "type": "string", "pattern": "^F-[A-Z0-9-]+$" }
      },
      "additionalProperties": false
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "priority", "chain"],
        "properties": {
          "type": {
            "enum": [
              "SOS",
              "FALL",
              "INACTIVITY",
              "CALLBACK",
              "WATCH_OFF",
              "BATTERY_LOW",
              "BATTERY_DEAD",
              "CONNECTION_LOST",
              "ROUTINE_DEVIATION",
              "HEART_ANOMALY",
              "TEST",
              "FOLLOW_UP",
              "COVERAGE_GAP",
              "WELFARE_CHECK",
              "SPO2_LOW"
            ]
          },
          "priority": { "type": "integer", "minimum": 1, "maximum": 4 },
          "devicePrompt": {
            "type": "object",
            "properties": {
              "enabled": { "type": "boolean" },
              "windowSec": { "type": "integer" },
              "repeatVibrateSec": { "type": "integer" },
              "silent": { "type": "boolean" },
              "tts": { "type": "string" }
            }
          },
          "escalateWhen": { "type": "object" },
          "thresholdMin": {
            "type": "object",
            "properties": {
              "default": { "type": "integer" },
              "learnable": { "type": "boolean" },
              "min": { "type": "integer" },
              "max": { "type": "integer" }
            }
          },
          "activeHours": { "type": "object" },
          "autoVoiceScreening": {
            "description": "D-12 otomatik sesli ön eleme (T-072): soru/bekleme cevapsızsa operatörden önce kişiye TTS araması; INACTIVITY / WATCH_OFF gibi sorulu/bekleyen türler, COVERAGE_GAP ve P3 değer olayları (T-092, V-VITAL-ASK); asla SOS/FALL",
            "type": "object",
            "required": ["enabled", "phrase", "acceptIf"],
            "properties": {
              "enabled": { "type": "boolean" },
              "phrase": {
                "type": "string",
                "pattern": "^V-[A-Z0-9-]+$",
                "description": "Soru metni (katalog, voice kanalı)"
              },
              "acceptIf": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 2 },
                "description": "Kelime başında eşleşirse OK (ör. evet, iyiyim)"
              },
              "helpIf": {
                "type": "array",
                "items": { "type": "string", "minLength": 2 },
                "description": "Eşleşirse HELP (OK'dan önce bakılır; ör. hayır, yardım, değil)"
              },
              "acceptDigits": { "type": "array", "items": { "type": "string", "pattern": "^[0-9]$" } },
              "minConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
              "timeoutSec": { "type": "integer", "minimum": 30, "maximum": 600 },
              "operatorSampleRate": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Öğrenme modunda (ilk ay) OK sonuçlarının operatöre CALLBACK olarak düşen oranı (yanlış pozitif ölçümü)"
              }
            },
            "additionalProperties": false
          },
          "learningMode": {
            "description": "Öğrenme modundayken (D-06): operatöre düşmeden önce ek sessiz soru sayısı",
            "type": "object",
            "properties": { "extraSilentAsks": { "type": "integer", "minimum": 0, "maximum": 1 } },
            "additionalProperties": false
          },
          "suppressIn": { "type": "array", "items": { "enum": ["NIGHT", "PROTECTED_PHONE", "UNPROTECTED"] } },
          "remindAfterMin": { "type": "integer" },
          "operatorAfterMin": { "type": "integer" },
          "afterHours": { "type": "integer" },
          "chain": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(CALL_WATCH|CALL_VOICE_2:2|CALL_PHONE|CALL_REDIAL|CALL_CONTACT:[1-5]|CALL_KEY_HOLDER|CALL_NEIGHBOR|CALL_112|NOTIFY_FAMILY|DISPATCH_PRIVATE)$"
            }
          },
          "stepTimeoutSec": { "type": "object", "additionalProperties": { "type": "integer" } },
          "silenceIsEmergencySec": { "type": "integer" },
          "followUpAfterHours": { "type": "integer" },
          "operatorScript": {
            "type": "string",
            "pattern": "^O-SCRIPT-[A-Z0-9-]+$",
            "description": "Bu olay tipinde kişi/yakın aramalarında operatör metni (112 hariç); ör. TEST → kurulum görüşmesi"
          }
        },
        "additionalProperties": false,
        "if": { "properties": { "type": { "enum": ["SOS", "FALL"] } }, "required": ["type"] },
        "then": { "not": { "required": ["autoVoiceScreening"] } }
      }
    }
  }
}
