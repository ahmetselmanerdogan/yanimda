{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProcedurePack",
  "type": "object",
  "required": ["country", "version", "steps"],
  "additionalProperties": false,
  "properties": {
    "country": { "type": "string", "minLength": 2, "maxLength": 2 },
    "version": { "type": "integer", "minimum": 1 },
    "steps": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[A-Z0-9_]+$" },
      "additionalProperties": {
        "type": "object",
        "required": ["label", "target", "required", "defaultTimeoutSec"],
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string", "pattern": "^O-[A-Z0-9-]+$" },
          "script": { "type": "string", "pattern": "^O-[A-Z0-9-]+$" },
          "target": { "enum": ["WATCH", "ELDER_PHONE", "CONTACT", "NEIGHBOR", "EMERGENCY", "FAMILY"] },
          "required": { "type": "boolean" },
          "defaultTimeoutSec": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
